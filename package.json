{
  "name": "ros-madair-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "copy-duckdb": "mkdir -p public/duckdb && cp node_modules/@duckdb/duckdb-wasm/dist/duckdb-mvp.wasm node_modules/@duckdb/duckdb-wasm/dist/duckdb-eh.wasm node_modules/@duckdb/duckdb-wasm/dist/duckdb-browser-mvp.worker.js node_modules/@duckdb/duckdb-wasm/dist/duckdb-browser-eh.worker.js public/duckdb/",
    "copy-ros-madair": "mkdir -p public/ros-madair && cp node_modules/ros-madair/ros_madair_wasm_bg.wasm public/ros-madair/",
    "gen-sample-data": "node scripts/gen-sample-data.mjs",
    "gen-emit-corpus": "node scripts/gen-emit-corpus.mjs",
    "gen-data": "npm run gen-sample-data && npm run gen-emit-corpus && npm run gen-aonach",
    "prebuild": "npm run copy-duckdb && npm run copy-ros-madair && npm run gen-data",
    "build": "next build",
    "predev": "npm run copy-duckdb && npm run copy-ros-madair && npm run gen-data",
    "dev": "next dev",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "gen-aonach": "node scripts/gen-aonach-mor.mjs",
    "perf": "node scripts/perf-suite.mjs"
  },
  "dependencies": {
    "@alizarin/clm": "^2.0.0-beta.7",
    "@alizarin/filelist": "^2.0.0-beta.7",
    "@duckdb/duckdb-wasm": "^1.29.0",
    "alizarin": "^2.0.0-beta.7",
    "flatbush": "^4.6.2",
    "fumadocs-core": "15.2.13",
    "fumadocs-mdx": "11.6.2",
    "fumadocs-ui": "15.2.13",
    "next": "15.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ros-madair": "0.1.0-alpha.25"
  },
  "devDependencies": {
    "@duckdb/node-api": "^1.5.5-r.4",
    "@tailwindcss/postcss": "^4.1.5",
    "@types/mdx": "^2.0.13",
    "@types/node": "22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "eslint": "^8",
    "eslint-config-next": "15.3.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.8.3"
  }
}
